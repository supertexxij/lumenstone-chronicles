; Engine configuration file.
config_version=5

[application]

config/name="Lumenstone Chronicles"
config/description="Christian/creationist Grade 3 homeschool RPG — RuneScape-style open village with guild learning quests."
config/version="1.41.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
